# -------------------------------
# Pyenv setup for Bash (mac + linux)
# -------------------------------

# Always set this first
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"

# Now check if pyenv exists (it will now be in PATH)
if command -v pyenv 1>/dev/null 2>&1; then
  export PYENV_VIRTUALENV_DISABLE_PROMPT=1
  eval "$(pyenv init --path)"
  eval "$(pyenv init -)"
  eval "$(pyenv virtualenv-init -)"  # Optional
fi

# -------------------------------
# Minimal Calm Status Line (appears only once per screen)
# -------------------------------

# Colors
BASE='\033[38;2;220;220;220m'     # soft white
GIT='\033[38;2;230;140;140m'      # gentle red
TIME='\033[38;2;180;160;220m'     # soft lavender/purple
PYENV='\033[38;2;140;170;230m'    # gentle blue
HOST='\033[38;2;160;200;255m'     # gentle blue/cyan for hostname
RESET='\033[0m'

__STATUS_SHOWN=0  # flag for whether to show status line

# Pyenv (leftmost) — show 3.x.x or 3.x.x (<venvname>)
pyenv_version() {
  # Get active Python version (works for pyenv, system, and venv)
  local py_version=""
  if command -v python >/dev/null 2>&1; then
    py_version=$(python - <<'PYCODE'
import sys
print(f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}")
PYCODE
)
  elif command -v python3 >/dev/null 2>&1; then
    py_version=$(python3 - <<'PYCODE'
import sys
print(f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}")
PYCODE
)
  fi

  # If a venv is active, append its basename, regardless of pyenv state
  local suffix=""
  if [[ -n "$VIRTUAL_ENV" ]]; then
    suffix=" ($(basename "$VIRTUAL_ENV"))"
  fi

  # Decide visibility:
  # - If venv is active -> always show.
  # - Else, show only when pyenv manages a non-"system" version.
  if [[ -n "$suffix" ]]; then
    [[ -n "$py_version" ]] && echo "${PYENV} $py_version$suffix${RESET}"
  else
    if command -v pyenv >/dev/null 2>&1; then
      local vername
      vername=$(pyenv version-name 2>/dev/null)
      if [[ -n "$vername" && "$vername" != "system" ]]; then
        echo "${PYENV} ${vername:-$py_version}${RESET}"
      fi
    fi
  fi
}

# Git (middle-left)
git_branch() {
  local branch
  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
  [[ -n "$branch" ]] && echo "${GIT} $branch${RESET}"
}

# Time (rightmost)
current_time() {
  echo "${TIME}⏱ $(date +'%H:%M')${RESET}"
}

# Get readable host name
readable_hostname() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS: use scutil to get user-friendly name
    local name
    name=$(scutil --get ComputerName 2>/dev/null)
    [[ -n "$name" ]] && echo "$name" && return
  elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    # Linux: use hostnamectl if available
    if command -v hostnamectl &>/dev/null; then
      local name
      name=$(hostnamectl --pretty status 2>/dev/null)
      [[ -n "$name" ]] && echo "$name" && return
    fi
  fi
  # Fallback
  hostname
}

# Hostname (right-aligned, left of time)
host_name() {
  local name
  name=$(readable_hostname)
  echo "${HOST} $name${RESET}"
}

# Redirect ssh for the waveserver
ssh() {
  if [[ "$1" == "waveserver" ]]; then
    ~/.ssh/ssh-waveserver.sh "${@:2}"
  else
    command ssh "$@"
  fi
}

# Strip ANSI escape sequences
strip_ansi() {
  sed 's/\x1b\[[0-9;]*m//g'
}

# Print status line once (after terminal clear)
status_line_once() {
  if [[ $__STATUS_SHOWN -eq 0 ]]; then
    local pyenv=$(pyenv_version)
    local git=$(git_branch)
    local host=$(host_name)
    local time=$(current_time)

    local left="${pyenv} ${git}"
    local right="${host}  ${time}"  # space between host and time

    local plain_left=$(echo -e "$left" | strip_ansi)
    local plain_right=$(echo -e "$right" | strip_ansi)

    local cols=$(tput cols)
    local middle=$((cols - ${#plain_left} - ${#plain_right}))
    (( middle < 1 )) && middle=1

    printf "%b%*s%b\n" "$left" "$middle" "" "$right"
    __STATUS_SHOWN=1
  fi
}

# Redefine clear to also reset status flag
clear() {
  __STATUS_SHOWN=0
  command clear
}

bind -x '"\C-l": "clear"'

# Short path (last folder, for prompt)
short_pwd() {
  local path="$PWD"
  local icloud="$HOME/Library/Mobile Documents/com~apple~CloudDocs"

  # Replace iCloud root with "iCloud"
  if [[ "$path" == "$icloud"* ]]; then
    path="iCloud${path#$icloud}"
  elif [[ "$path" == "$HOME"* ]]; then
    path="~${path#$HOME}"
  fi

  # Split path into parts
  IFS='/' read -ra parts <<< "$path"
  local len=${#parts[@]}

  if (( len == 0 )); then
    echo "~"
  else
    echo "${parts[len-1]}"
  fi
}

# Prompt: short path and calm arrow
PATH_COLOR='\033[38;2;190;255;190m'
ARROW_COLOR='\033[38;2;160;200;255m'
PS1='\['"$PATH_COLOR"'\]$(short_pwd) \['"$ARROW_COLOR"'\]>\['"$RESET"'\] '

# Only show top bar once
PROMPT_COMMAND=status_line_once

# set iCloud function
icloud() {
  cd "$HOME/Library/Mobile Documents/com~apple~CloudDocs/$1" || return
}

# terminal-wakatime setup
export PATH="$HOME/.wakatime:$PATH"
eval "$(terminal-wakatime init)"
